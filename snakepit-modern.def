Bootstrap: docker
From: ubuntu:24.04

%help
    Ubuntu 24.04 container with Python 3.12, 3.13, 3.14, 3.15 (native apt +
    deadsnakes PPA) plus 3.14t/3.15t free-threading builds (uv/python-build-
    standalone prebuilt binaries).

    Covers the CPython versions that manylinux2014 can present as interpreters
    but can no longer actually test: numpy stopped publishing manylinux2014
    (glibc 2.17 / GCC 10) wheels for cp312+, and that CentOS 7 image has no
    newer devtoolset to build from source either. Modern glibc here means
    pip installs real numpy/h5py/numba wheels with no source build needed.

%labels
    Author Snakepit
    Version 1.0
    BaseOS Ubuntu 24.04

%post
    export DEBIAN_FRONTEND=noninteractive

    apt-get update && apt-get install -y \
        git \
        build-essential \
        software-properties-common \
        curl \
        libhdf5-dev \
        && rm -rf /var/lib/apt/lists/*

    # Add deadsnakes PPA (provides 3.13/3.14/3.15 for noble; 3.12 is noble's
    # own native default and comes from Ubuntu's main repo either way)
    add-apt-repository ppa:deadsnakes/ppa -y

    apt-get update && apt-get install -y \
        python3.12 python3.12-dev python3.12-venv \
        python3.13 python3.13-dev python3.13-venv \
        python3.14 python3.14-dev python3.14-venv \
        python3.15 python3.15-dev python3.15-venv \
        python3-pip \
        && rm -rf /var/lib/apt/lists/*

    # Install uv for the free-threading builds (no apt/PPA source for these)
    curl -LsSf https://astral.sh/uv/install.sh | sh
    export PATH="/root/.local/bin:$PATH"

    # Python 3.14t (free-threading)
    uv python install cpython-3.14.0+freethreaded-linux-x86_64-gnu || \
        echo "Python 3.14t not available via uv"
    FT314=$(uv python find cpython-3.14.*+freethreaded* 2>/dev/null || true)
    if [ -n "$FT314" ]; then
        ln -s "$FT314" /usr/local/bin/python3.14t
        FTBIN314=$(dirname "$FT314")
        ln -s "$FTBIN314"/pip* /usr/local/bin/ 2>/dev/null || true
        ln -s "$FTBIN314"/python*-config /usr/local/bin/ 2>/dev/null || true
    fi

    # Python 3.15t (free-threading, pre-release; try newest tag first)
    uv python install cpython-3.15.0+freethreaded-linux-x86_64-gnu || \
        uv python install cpython-3.15.0rc2+freethreaded-linux-x86_64-gnu || \
        uv python install cpython-3.15.0rc1+freethreaded-linux-x86_64-gnu || \
        uv python install cpython-3.15.0b4+freethreaded-linux-x86_64-gnu || \
        echo "Python 3.15t not available via uv"
    FT315=$(uv python find cpython-3.15.*+freethreaded* 2>/dev/null || true)
    if [ -n "$FT315" ]; then
        ln -s "$FT315" /usr/local/bin/python3.15t
        FTBIN315=$(dirname "$FT315")
        ln -s "$FTBIN315"/pip* /usr/local/bin/ 2>/dev/null || true
        ln -s "$FTBIN315"/python*-config /usr/local/bin/ 2>/dev/null || true
    fi

    # Verify installations
    python3.12 --version && \
        python3.13 --version && \
        python3.14 --version && \
        python3.15 --version && \
        (python3.14t --version || echo "Python 3.14t not installed") && \
        (python3.15t --version || echo "Python 3.15t not installed")

%environment
    export DEBIAN_FRONTEND=noninteractive
    export PATH="/root/.local/bin:$PATH"

%runscript
    exec /bin/bash "$@"
