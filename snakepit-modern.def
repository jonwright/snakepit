Bootstrap: docker
From: ubuntu:24.04

%help
    Ubuntu 24.04 container with Python 3.9, 3.10, 3.11, 3.12, 3.13, 3.14, 3.15,
    3.16 (alpha) (native apt + deadsnakes PPA) plus 3.14t/3.15t/3.16t
    free-threading builds and PyPy 3.11
    (uv/python-build-standalone prebuilt binaries).

    Covers the CPython versions that manylinux2014 can present as interpreters
    but can no longer actually test: numpy stopped publishing manylinux2014
    (glibc 2.17 / GCC 10) wheels for cp312+, and that CentOS 7 image has no
    newer devtoolset to build from source either. Modern glibc here means
    pip installs real numpy/h5py/numba wheels with no source build needed.

    3.9/3.10/3.11 are also included here (as well as in snakepit-manylinux2014.sif)
    to preserve the original six-container design's deliberate dual-glibc
    testing for those versions -- once on modern glibc (here), once on the
    old CentOS 7 / glibc 2.17 baseline (manylinux2014).

%labels
    Author Snakepit
    Version 1.0
    BaseOS Ubuntu 24.04

%files
    install_sci_packages.sh /opt/snakepit/install_sci_packages.sh

%post
    export DEBIAN_FRONTEND=noninteractive

    apt-get update && apt-get install -y \
        git \
        build-essential \
        software-properties-common \
        curl \
        libhdf5-dev \
        && rm -rf /var/lib/apt/lists/*

    # Add deadsnakes PPA (provides 3.13-3.16 for noble; 3.12 is noble's
    # own native default and comes from Ubuntu's main repo either way)
    add-apt-repository ppa:deadsnakes/ppa -y

    apt-get update && apt-get install -y \
        python3.9 python3.9-dev python3.9-venv \
        python3.10 python3.10-dev python3.10-venv \
        python3.11 python3.11-dev python3.11-venv \
        python3.12 python3.12-dev python3.12-venv \
        python3.13 python3.13-dev python3.13-venv \
        python3.14 python3.14-dev python3.14-venv \
        python3.15 python3.15-dev python3.15-venv \
        python3-pip \
        && rm -rf /var/lib/apt/lists/*

    # Python 3.16 (alpha, deadsnakes) -- optional so a PPA gap doesn't fail the build
    apt-get update && apt-get install -y \
        python3.16 python3.16-dev python3.16-venv \
        || echo "Python 3.16 not available from deadsnakes"
    rm -rf /var/lib/apt/lists/*

    # Install uv for the free-threading builds (no apt/PPA source for these)
    curl -LsSf https://astral.sh/uv/install.sh | sh
    export PATH="/root/.local/bin:$PATH"

    # Free-threading builds. Request by minor version ("3.14t") so uv picks the
    # newest patch/pre-release available at build time instead of a pinned tag.
    # 3.16t is alpha -- allowed to be missing.
    for FTV in 3.14t 3.15t 3.16t; do
        uv python install "$FTV" || { echo "Python $FTV not available via uv"; continue; }
        FT=$(uv python find "$FTV" 2>/dev/null || true)
        if [ -n "$FT" ]; then
            ln -sf "$FT" /usr/local/bin/python$FTV
            FTBIN=$(dirname "$FT")
            ln -s "$FTBIN"/pip* /usr/local/bin/ 2>/dev/null || true
            ln -s "$FTBIN"/python*-config /usr/local/bin/ 2>/dev/null || true
        fi
    done

    # PyPy 3.11 via uv (prebuilt). Lives here, not in manylinux2014: numpy's
    # pp311 wheels are manylinux_2_28 (glibc >= 2.28). Pinned to uv's
    # pypy-3.11.15 = PyPy 7.3.23, the last 7.3.x (ABI pp73): PyPy 8.x is ABI
    # pp80 and numpy (2.4.x was its last PyPy series) has no pp80 wheels.
    uv python install pypy-3.11.15 || echo "PyPy 3.11 not available via uv"
    PYPY311=$(uv python find pypy-3.11.15 2>/dev/null || true)
    if [ -n "$PYPY311" ]; then
        ln -sf "$PYPY311" /usr/local/bin/pypy3.11
    fi

    # numpy/numba/h5py into each interpreter's system site-packages (wheels only)
    bash /opt/snakepit/install_sci_packages.sh \
        python3.9 python3.10 python3.11 python3.12 python3.13 python3.14 \
        python3.15 python3.16 python3.14t python3.15t python3.16t pypy3.11

    # Verify installations
    python3.9 --version && \
        python3.10 --version && \
        python3.11 --version && \
        python3.12 --version && \
        python3.13 --version && \
        python3.14 --version && \
        python3.15 --version && \
        (python3.16 --version || echo "Python 3.16 not installed") && \
        (python3.14t --version || echo "Python 3.14t not installed") && \
        (python3.15t --version || echo "Python 3.15t not installed") && \
        (python3.16t --version || echo "Python 3.16t not installed") && \
        (pypy3.11 --version || echo "PyPy 3.11 not installed")

%environment
    export DEBIAN_FRONTEND=noninteractive
    # Host LC_ALL (e.g. en_US.UTF-8) isn't generated here; PyPy aborts on it
    export LC_ALL=C.UTF-8
    export PATH="/root/.local/bin:$PATH"

%runscript
    exec /bin/bash "$@"
